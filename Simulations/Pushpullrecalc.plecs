          Schematic {
            Location      [0, 365; 277, 586]
            ZoomFactor    1
            SliderPosition [0, 0]
            ShowBrowser   off
            BrowserWidth  100
            Component {
              Type          CScript
              Name          "Bipolar PWM"
              Show          on
              Position      [115, 75]
              Direction     up
              Flipped       off
              LabelPosition south
              Parameter {
                Variable      "DialogGeometry"
                Value         "[268 171 682 684]"
                Show          off
              }
              Parameter {
                Variable      "NumInputs"
                Value         "1"
                Show          off
              }
              Parameter {
                Variable      "NumOutputs"
                Value         "1"
                Show          off
              }
